{
  "name": "@local/dsh-codex-tools",
  "version": "2.0.28",
  "private": true,
  "description": "Operate desktop apps and browser windows, and manage those permissions.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.1-rc.1",
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./icon": "./icon.svg",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib/*.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/*.md",
    "native/*",
    "bin/*",
    "client.js",
    "client-entry.js",
    "locale/*.json"
  ],
  "scripts": {
    "test": "node --test tests/unit.test.mjs tests/update.test.mjs tests/update-route.test.mjs tests/settings-behavior.test.mjs tests/browser-keys.test.mjs tests/chrome-args.test.mjs tests/online-update.test.mjs tests/format-time.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syngnat/dsh-codex-tools.git"
  },
  "homepage": "https://github.com/Syngnat/dsh-codex-tools#readme",
  "bugs": {
    "url": "https://github.com/Syngnat/dsh-codex-tools/issues"
  },
  "author": "Syngnat",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "computer-use",
    "browser",
    "codex"
  ]
}
